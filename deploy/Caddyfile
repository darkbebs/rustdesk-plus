# ── RustDesk Plus — Caddyfile ──────────────────────────────────────────────────
#
# CADDY_ADDR controla HTTP vs HTTPS:
#   HTTP  (IP/sem domínio): CADDY_ADDR=:80
#   HTTPS (domínio público): CADDY_ADDR=painel.suaempresa.com
#
# Para HTTPS, o Caddy obtém e renova o certificado Let's Encrypt automaticamente.
# Exige que as portas 80 e 443 estejam abertas e apontando para este servidor.

# Quando o Caddy roda atras de outro proxy (nginx do host, load balancer), o peer
# TCP e o gateway do docker e nao o cliente. trusted_proxies faz o Caddy resolver
# {client_ip} pelo X-Forwarded-For recebido, ignorando os saltos internos.
{
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

{$CADDY_ADDR} {
    encode gzip

    # Cabeçalhos de segurança para HTTPS
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Rotas da API e WebSocket → plus-api
    @api {
        path /admin/* /api/* /ws/* /setup /setup/* /super/* /health /t/* /i/* /install/* /cert/*
    }
    handle @api {
        reverse_proxy plus-api:21114 {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Tudo o mais → dashboard Next.js
    handle {
        reverse_proxy dashboard:3000 {
            header_up Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
